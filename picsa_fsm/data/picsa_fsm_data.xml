<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="fsm_stage_study" model="fsm.stage">
            <field name="name">En estudio</field>
            <field name="code">study</field>
            <field name="sequence">10</field>
            <field name="is_default" eval="True"/>
            <field name="is_closed" eval="False"/>
            <field name="color">#E3F2FD</field>
        </record>

        <record id="fsm_stage_in_progress" model="fsm.stage">
            <field name="name">En proceso</field>
            <field name="code">in_process</field>
            <field name="sequence">20</field>
            <field name="is_default" eval="False"/>
            <field name="is_closed" eval="False"/>
            <field name="color">#FFD700</field>
        </record>

        <record id="fsm_stage_review" model="fsm.stage">
            <field name="name">En revisión</field>
            <field name="code">review</field>
            <field name="sequence">30</field>
            <field name="is_default" eval="False"/>
            <field name="is_closed" eval="False"/>
            <field name="color">#FFE4B5</field>
        </record>

        <record id="fsm_stage_to_invoice" model="fsm.stage">
            <field name="name">A facturar</field>
            <field name="code">to_invoice</field>
            <field name="sequence">40</field>
            <field name="is_default" eval="False"/>
            <field name="is_closed" eval="False"/>
            <field name="color">#FFE4B5</field>
        </record>

        <record id="fsm_stage_to_close" model="fsm.stage">
            <field name="name">A cerrar</field>
            <field name="code">to_close</field>
            <field name="sequence">50</field>
            <field name="is_default" eval="False"/>
            <field name="is_closed" eval="False"/>
            <field name="color">#D8BFD8</field>
        </record>

        <record id="fsm_stage_closed" model="fsm.stage">
            <field name="name">Cerrada</field>
            <field name="code">closed</field>
            <field name="sequence">60</field>
            <field name="is_default" eval="False"/>
            <field name="is_closed" eval="True"/>
            <field name="color">#90EE90</field>
        </record>

        <record id="service_state_draft" model="picsa.fsm.service.state">
            <field name="name">En edición</field>
            <field name="code">draft</field>
            <field name="sequence">10</field>
            <field name="is_default" eval="True"/>
            <field name="is_closed" eval="False"/>
        </record>

        <record id="service_state_in_progress" model="picsa.fsm.service.state">
            <field name="name">En Proceso</field>
            <field name="code">in_progress</field>
            <field name="sequence">20</field>
            <field name="is_default" eval="False"/>
            <field name="is_closed" eval="False"/>
        </record>

        <record id="service_state_to_invoice" model="picsa.fsm.service.state">
            <field name="name">A facturar</field>
            <field name="code">to_invoice</field>
            <field name="sequence">30</field>
            <field name="is_default" eval="False"/>
            <field name="is_closed" eval="False"/>
        </record>

        <record id="service_state_to_close" model="picsa.fsm.service.state">
            <field name="name">A cerrar</field>
            <field name="code">to_close</field>
            <field name="sequence">40</field>
            <field name="is_default" eval="False"/>
            <field name="is_closed" eval="False"/>
        </record>

        <record id="service_state_done" model="picsa.fsm.service.state">
            <field name="name">Cerrada</field>
            <field name="code">done</field>
            <field name="sequence">50</field>
            <field name="is_default" eval="False"/>
            <field name="is_closed" eval="True"/>
        </record>

        <record id="intervention_method_onsite" model="picsa.fsm.intervention.method">
            <field name="name">Presencial</field>
            <field name="code">onsite</field>
            <field name="sequence">10</field>
        </record>

        <record id="intervention_method_remote" model="picsa.fsm.intervention.method">
            <field name="name">Remoto</field>
            <field name="code">remote</field>
            <field name="sequence">20</field>
        </record>

        <record id="intervention_method_phone" model="picsa.fsm.intervention.method">
            <field name="name">Telefónico</field>
            <field name="code">phone</field>
            <field name="sequence">30</field>
        </record>

        <record id="intervention_method_email" model="picsa.fsm.intervention.method">
            <field name="name">Email</field>
            <field name="code">email</field>
            <field name="sequence">40</field>
        </record>

        <record id="intervention_method_other" model="picsa.fsm.intervention.method">
            <field name="name">Otro</field>
            <field name="code">other</field>
            <field name="sequence">50</field>
        </record>
    </data>
</odoo>
