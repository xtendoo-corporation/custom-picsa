<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_picsa_fsm_incident" model="ir.actions.report">
        <field name="name">Informe Parte de Incidencia</field>
        <field name="model">fsm.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">picsa_fsm.report_picsa_fsm_incident</field>
        <field name="report_file">picsa_fsm.report_picsa_fsm_incident</field>
        <field name="print_report_name">'Informe Parte de Incidencia - %s' % (object.name)</field>
        <field name="binding_model_id" ref="xtendoo_fsm.model_fsm_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_picsa_fsm_incident">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="picsa_fsm.report_picsa_fsm_incident_document"/>
            </t>
        </t>
    </template>

    <template id="report_picsa_fsm_incident_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <div class="page">
                <style>
                    .picsa_fsm_report h2 { margin: 0 0 12px 0; font-size: 22px; }
                    .picsa_fsm_report h5 {
                        margin: 10px 0 7px 0;
                        padding: 0;
                        font-size: 15px;
                        font-weight: 700;
                    }
                    .picsa_fsm_report address { margin-bottom: 0; }
                    .picsa_fsm_report .table { margin-bottom: 10px; }
                    .picsa_fsm_report .table-sm th,
                    .picsa_fsm_report .table-sm td { padding: 4px 6px; }
                    .picsa_fsm_report p { margin-bottom: 5px; }
                    .picsa_fsm_report .picsa_block { margin-top: 12px; }
                    .picsa_fsm_report .picsa_signature { padding-top: 4px; }
                </style>
                <div class="picsa_fsm_report">
                <h2>Informe Parte de Incidencia</h2>

                <div class="row">
                    <div class="col-6">
                        <h5>Cliente</h5>
                        <address t-field="doc.partner_id"
                                 t-options='{"widget": "contact", "fields": ["address", "name", "phone", "email"], "no_marker": True}'/>
                    </div>
                    <div class="col-6 text-end">
                        <div><strong>Parte:</strong> <span t-field="doc.name"/></div>
                        <div><strong>Fecha:</strong> <span t-field="doc.date_created" t-options="{'widget': 'date'}"/></div>
                        <div t-if="doc.stage_id"><strong>Estado:</strong> <span t-field="doc.stage_id"/></div>
                    </div>
                </div>

                <div class="picsa_block">
                    <h5>Incidencia</h5>
                    <table class="table table-sm table-borderless">
                        <tbody>
                            <tr>
                                <td class="fw-bold w-25">Nombre de Incidencia</td>
                                <td colspan="3">
                                    <span t-field="doc.incident_name"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Responsable</td>
                                <td><span t-field="doc.incident_responsible_id"/></td>
                                <td class="fw-bold">Estado</td>
                                <td><span t-field="doc.stage_id"/></td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Abierto</td>
                                <td><span t-field="doc.incident_open_date"/></td>
                                <td class="fw-bold">Actualizado</td>
                                <td><span t-field="doc.incident_update_date"/></td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Fecha de Incidencia</td>
                                <td><span t-field="doc.incident_date"/></td>
                                <td class="fw-bold">Tipo de Incidencia</td>
                                <td><span t-field="doc.incident_type_id"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="picsa_block">
                    <h5>Servicios a realizar</h5>
                    <div t-field="doc.description"/>
                </div>

                <div class="picsa_block">
                    <h5>Material Instalado</h5>
                    <table class="table table-sm o_main_table table-bordered">
                        <thead>
                            <tr>
                                <th>Nº</th>
                                <th>Marca</th>
                                <th>Modelo</th>
                                <th>Nº Serie</th>
                                <th>Cantidad</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.material_installed_ids" t-as="material">
                                <td><span t-field="material.sequence"/></td>
                                <td><span t-field="material.brand"/></td>
                                <td><span t-field="material.model_id"/></td>
                                <td><span t-field="material.serial_number"/></td>
                                <td><span t-field="material.quantity"/></td>
                            </tr>
                            <tr t-if="not doc.material_installed_ids">
                                <td colspan="5" class="text-muted">Sin material instalado.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="picsa_block">
                    <h5>Material Retirado</h5>
                    <table class="table table-sm o_main_table table-bordered">
                        <thead>
                            <tr>
                                <th>Nº</th>
                                <th>Marca</th>
                                <th>Modelo</th>
                                <th>Nº Serie</th>
                                <th>Cantidad</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.material_removed_ids" t-as="material">
                                <td><span t-field="material.sequence"/></td>
                                <td><span t-field="material.brand"/></td>
                                <td><span t-field="material.model_id"/></td>
                                <td><span t-field="material.serial_number"/></td>
                                <td><span t-field="material.quantity"/></td>
                            </tr>
                            <tr t-if="not doc.material_removed_ids">
                                <td colspan="5" class="text-muted">Sin material retirado.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="picsa_block">
                    <h5>Servicios Realizados</h5>
                    <table class="table table-sm o_main_table table-bordered">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Técnico Asignado</th>
                                <th>Fecha Inicio</th>
                                <th>Fecha Fin</th>
                                <th>Método Intervención</th>
                                <th>Km</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.picsa_service_ids" t-as="service">
                                <td><span t-field="service.id"/></td>
                                <td><span t-field="service.technician_id"/></td>
                                <td><span t-field="service.date_start"/></td>
                                <td><span t-field="service.date_end"/></td>
                                <td><span t-field="service.intervention_method_id"/></td>
                                <td><span t-field="service.km"/></td>
                                <td><span t-field="service.state_id"/></td>
                            </tr>
                            <tr t-if="not doc.picsa_service_ids">
                                <td colspan="7" class="text-muted">Sin servicios realizados.</td>
                            </tr>
                        </tbody>
                    </table>
                    <t t-foreach="doc.picsa_service_ids" t-as="service">
                        <div class="row mt-1" t-if="service.notes or service.signature">
                            <div class="col-8">
                                <strong>Descripción #<span t-field="service.id"/>:</strong>
                                <span t-field="service.notes"/>
                            </div>
                            <div class="col-4 picsa_signature" t-if="service.signature">
                                <strong>Firma:</strong>
                                <br/>
                                <img t-att-src="image_data_uri(service.signature)"
                                     style="max-height: 64px; max-width: 200px;"/>
                            </div>
                        </div>
                    </t>
                </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
