<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_picsa_fsm_incident" model="ir.actions.report">
        <field name="name">Informe Parte de Incidencia</field>
        <field name="model">fsm.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">picsa_fsm.report_picsa_fsm_incident</field>
        <field name="report_file">picsa_fsm.report_picsa_fsm_incident</field>
        <field name="print_report_name">'Informe Parte de Incidencia - %s' % (object.name)</field>
        <field name="binding_model_id" ref="xtendoo_fsm.model_fsm_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_picsa_fsm_incident">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="picsa_fsm.report_picsa_fsm_incident_document"/>
            </t>
        </t>
    </template>

    <template id="report_picsa_fsm_incident_document">
        <t t-call="web.basic_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <style>
                .picsa-page { font-size: 13px; color: #111; }
                .picsa-title { text-align: center; font-size: 22px; font-weight: 700; margin-top: 18px; border-bottom: 1px solid #333; }
                .picsa-meta { text-align: right; font-size: 11px; line-height: 1.35; }
                .picsa-logo { color: #0b4f86; font-size: 28px; font-weight: 800; letter-spacing: 1px; }
                .picsa-logo-sub { color: #0b4f86; font-size: 8px; font-weight: 700; margin-top: -6px; }
                .picsa-section-title { background: #cfcfcf; font-size: 16px; font-weight: 800; padding: 3px 6px; margin-top: 12px; text-transform: uppercase; }
                .picsa-block { padding: 7px 8px; }
                .picsa-label { font-weight: 700; }
                .picsa-table { width: 100%; border-collapse: collapse; margin-top: 6px; }
                .picsa-table th, .picsa-table td { border: 1px solid #333; padding: 6px; vertical-align: top; }
                .picsa-table th { font-weight: 700; text-align: center; }
                .picsa-state { display: inline-block; min-width: 170px; padding: 3px 12px; color: #111; }
                .picsa-state-open { background: #f6c76a; }
                .picsa-state-progress { background: #59b6e8; }
                .picsa-state-done { background: #58b878; }
                .picsa-state-cancelled { background: #d7d7d7; }
                .picsa-line { border-bottom: 1px solid #ddd; padding: 8px 0; }
            </style>
            <div class="page picsa-page">
                <div class="row">
                    <div class="col-6">
                        <div class="picsa-logo">PICSA</div>
                        <div class="picsa-logo-sub">SOLUCIONES INFORMATICAS S.L.</div>
                    </div>
                    <div class="col-6 picsa-meta">
                        <div>Fecha: <span t-field="doc.date_created" t-options="{'widget': 'date'}"/></div>
                        <div>Núm: <span t-field="doc.name"/></div>
                        <div>Pag: <span class="page"/>/<span class="topage"/></div>
                    </div>
                </div>

                <div class="picsa-title">Informe Parte de Incidencia</div>

                <div class="picsa-section-title">Cliente:</div>
                <div class="picsa-block">
                    <div><strong><span t-field="doc.partner_id.name"/></strong></div>
                    <div t-if="doc.location_id">
                        <span t-field="doc.location_id.street"/>
                        <t t-if="doc.location_id.street2">, <span t-field="doc.location_id.street2"/></t>
                    </div>
                    <div t-if="doc.location_id">
                        <span t-field="doc.location_id.zip"/> <span t-field="doc.location_id.city"/>
                    </div>
                    <div t-if="doc.contact_id">Persona Contacto: <span t-field="doc.contact_id.name"/></div>
                    <div>
                        Tel: <span t-esc="doc.contact_id.phone or doc.partner_id.phone or ''"/>
                        <t t-if="doc.contact_id.email or doc.partner_id.email">
                            Email: <span t-esc="doc.contact_id.email or doc.partner_id.email"/>
                        </t>
                    </div>
                </div>

                <div class="picsa-section-title">Incidencia:</div>
                <div class="picsa-block">
                    <t t-set="incident" t-value="doc.incident_ids[:1]"/>
                    <div><strong><span t-esc="incident.name if incident else doc.description"/></strong></div>
                    <div class="row">
                        <div class="col-7">
                            <div><span class="picsa-label">Responsable:</span> <span t-esc="incident.responsible_id.name if incident else (doc.responsible_id.name or '')"/></div>
                            <div><span class="picsa-label">Abierto:</span> <span t-esc="format_datetime(incident.create_date) if incident and incident.create_date else ''"/></div>
                            <div><span class="picsa-label">Fecha Incidencia:</span> <span t-esc="format_datetime(incident.incident_date) if incident and incident.incident_date else ''"/></div>
                            <div><span class="picsa-label">Tipo Incidencia:</span> <span t-esc="dict(incident._fields['incident_type'].selection).get(incident.incident_type, '') if incident else ''"/></div>
                        </div>
                        <div class="col-5">
                            <div>
                                <span class="picsa-label">Estado:</span>
                                <span t-if="incident"
                                      t-att-class="'picsa-state picsa-state-%s' % (incident.state == 'in_progress' and 'progress' or incident.state)">
                                    <span t-esc="dict(incident._fields['state'].selection).get(incident.state)"/>
                                </span>
                            </div>
                            <div><span class="picsa-label">Actualizado:</span> <span t-esc="format_datetime(incident.write_date) if incident and incident.write_date else ''"/></div>
                        </div>
                    </div>
                </div>

                <div class="picsa-section-title">Servicios a Realizar:</div>
                <div class="picsa-block">
                    <span t-field="doc.description"/>
                </div>

                <div class="picsa-section-title">Material Instalado</div>
                <table class="picsa-table">
                    <thead>
                        <tr>
                            <th style="width: 6%;">Nº</th>
                            <th style="width: 12%;">Marca</th>
                            <th style="width: 18%;">Modelo</th>
                            <th>Nº Serie</th>
                            <th style="width: 14%;">Cantidad</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr style="height: 72px;"><td></td><td></td><td></td><td></td><td></td></tr>
                    </tbody>
                </table>

                <div class="picsa-section-title">Material Retirado</div>
                <table class="picsa-table">
                    <thead>
                        <tr>
                            <th style="width: 6%;">Nº</th>
                            <th style="width: 12%;">Marca</th>
                            <th style="width: 18%;">Modelo</th>
                            <th>Nº Serie</th>
                            <th style="width: 14%;">Cantidad</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr style="height: 72px;"><td></td><td></td><td></td><td></td><td></td></tr>
                    </tbody>
                </table>

                <div class="picsa-section-title">Servicios Realizados</div>
                <div class="picsa-block">
                    <t t-foreach="doc.picsa_service_ids" t-as="service">
                        <div class="picsa-line">
                            <div class="row">
                                <div class="col-2"><strong>#<span t-field="service.id"/></strong></div>
                                <div class="col-5">
                                    <div><span class="picsa-label">Técnico asignado:</span> <span t-field="service.technician_id"/></div>
                                    <div>
                                        <span class="picsa-label">Fecha:</span>
                                        <span t-field="service.date_start" t-options="{'widget': 'date'}"/>
                                        <span class="picsa-label">Inicio:</span> <span t-field="service.date_start" t-options="{'widget': 'time'}"/>
                                        <span class="picsa-label">Fin:</span> <span t-field="service.date_end" t-options="{'widget': 'time'}"/>
                                    </div>
                                    <div>
                                        <span class="picsa-label">Método Intervención:</span>
                                        <span t-esc="dict(service._fields['intervention_method'].selection).get(service.intervention_method, '')"/>
                                        <span class="picsa-label">Km:</span> <span t-field="service.km"/>
                                    </div>
                                </div>
                                <div class="col-5">
                                    <span class="picsa-label">Estado:</span>
                                    <span t-att-class="'picsa-state picsa-state-%s' % (service.state == 'in_progress' and 'progress' or service.state)">
                                        <span t-esc="dict(service._fields['state'].selection).get(service.state)"/>
                                    </span>
                                </div>
                            </div>
                            <div t-if="service.notes" style="margin-top: 6px;">
                                <span t-field="service.notes"/>
                            </div>
                        </div>
                    </t>
                    <div t-if="not doc.picsa_service_ids" style="height: 56px;"></div>
                </div>
            </div>
        </t>
    </template>
</odoo>
