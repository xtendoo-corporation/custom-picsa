<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fsm_order_form_inherit_picsa_fsm" model="ir.ui.view">
        <field name="name">fsm.order.form.inherit.picsa.fsm</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="xtendoo_fsm.view_xtendoo_fsm_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='service_info']" position="replace">
                <group name="picsa_incident_info" string="Incidencia">
                    <field name="incident_name"/>
                    <field name="incident_responsible_id"/>
                    <field name="incident_open_date"/>
                    <field name="incident_date"/>
                    <field name="incident_type_id"/>
                    <field name="incident_update_date"/>
                    <field name="stage_id" string="Estado"/>
                </group>
            </xpath>
            <xpath expr="//group[@name='customer_info']" position="attributes">
                <attribute name="string">Información Básica</attribute>
            </xpath>
            <xpath expr="//group[@name='customer_info']" position="inside">
                <field name="description" string="Servicios a realizar"
                       widget="html" placeholder="Describe los servicios a realizar..."/>
            </xpath>
            <xpath expr="//button[@name='action_create_repair']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_view_repairs']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_create_sale_order']" position="attributes">
                <attribute name="invisible">sale_count &gt; 0</attribute>
            </xpath>

            <xpath expr="//group[@name='basic_info']" position="replace"/>
            <xpath expr="//group[@name='scheduling']" position="replace"/>
            <xpath expr="//notebook/page[.//field[@name='internal_note']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Material Instalado" name="picsa_material_installed">
                    <field name="material_installed_ids"
                           context="{'default_fsm_order_id': id, 'default_material_type': 'installed'}">
                        <tree editable="bottom" string="Material Instalado">
                            <field name="material_type" column_invisible="1"/>
                            <field name="sequence"/>
                            <field name="brand"/>
                            <field name="model_id"/>
                            <field name="serial_number"/>
                            <field name="quantity"/>
                        </tree>
                    </field>
                </page>
                <page string="Material Retirado" name="picsa_material_removed">
                    <field name="material_removed_ids"
                           context="{'default_fsm_order_id': id, 'default_material_type': 'removed'}">
                        <tree editable="bottom" string="Material Retirado">
                            <field name="material_type" column_invisible="1"/>
                            <field name="sequence"/>
                            <field name="brand"/>
                            <field name="model_id"/>
                            <field name="serial_number"/>
                            <field name="quantity"/>
                        </tree>
                    </field>
                </page>
                <page string="Servicios Realizados" name="picsa_services">
                    <field name="picsa_service_ids" context="{'default_fsm_order_id': id}">
                        <tree editable="bottom" string="Servicios Realizados">
                            <field name="id" string="ID" readonly="1"/>
                            <field name="state_code" column_invisible="1"/>
                            <field name="technician_id" readonly="state_code == 'done'"/>
                            <field name="date_start" readonly="state_code == 'done'"/>
                            <field name="date_end" readonly="state_code == 'done'"/>
                            <field name="intervention_method_id" readonly="state_code == 'done'"/>
                            <field name="km" readonly="state_code == 'done'"/>
                            <field name="state_id" readonly="state_code == 'done'"/>
                            <field name="notes" readonly="state_code == 'done'"/>
                            <button name="action_open_signature_wizard" string="Firmar" type="object"
                                    class="btn-link"/>
                            <button name="action_reopen" string="Reabrir" type="object"
                                    class="btn-link" invisible="state_code != 'done'"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_picsa_fsm_service_tree" model="ir.ui.view">
        <field name="name">picsa.fsm.service.tree</field>
        <field name="model">picsa.fsm.service</field>
        <field name="arch" type="xml">
            <tree string="Servicios Realizados">
                <field name="id" string="ID"/>
                <field name="fsm_order_id"/>
                <field name="state_code" column_invisible="1"/>
                <field name="technician_id" readonly="state_code == 'done'"/>
                <field name="date_start" readonly="state_code == 'done'"/>
                <field name="date_end" readonly="state_code == 'done'"/>
                <field name="intervention_method_id" readonly="state_code == 'done'"/>
                <field name="km" readonly="state_code == 'done'"/>
                <field name="state_id" readonly="state_code == 'done'"/>
                <field name="notes" readonly="state_code == 'done'"/>
                <button name="action_open_signature_wizard" string="Firmar" type="object"
                        class="btn-link"/>
                <button name="action_reopen" string="Reabrir" type="object"
                        class="btn-link" invisible="state_code != 'done'"/>
            </tree>
        </field>
    </record>

    <record id="view_picsa_fsm_incident_type_tree" model="ir.ui.view">
        <field name="name">picsa.fsm.incident.type.tree</field>
        <field name="model">picsa.fsm.incident.type</field>
        <field name="arch" type="xml">
            <tree string="Tipos de Incidencia">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_picsa_fsm_incident_type_form" model="ir.ui.view">
        <field name="name">picsa.fsm.incident.type.form</field>
        <field name="model">picsa.fsm.incident.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de Incidencia">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_picsa_fsm_service_state_tree" model="ir.ui.view">
        <field name="name">picsa.fsm.service.state.tree</field>
        <field name="model">picsa.fsm.service.state</field>
        <field name="arch" type="xml">
            <tree string="Estados de Servicio">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="is_default"/>
                <field name="is_closed"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_picsa_fsm_service_state_form" model="ir.ui.view">
        <field name="name">picsa.fsm.service.state.form</field>
        <field name="model">picsa.fsm.service.state</field>
        <field name="arch" type="xml">
            <form string="Estado de Servicio">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="is_default"/>
                        <field name="is_closed"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_picsa_fsm_intervention_method_tree" model="ir.ui.view">
        <field name="name">picsa.fsm.intervention.method.tree</field>
        <field name="model">picsa.fsm.intervention.method</field>
        <field name="arch" type="xml">
            <tree string="Métodos de Intervención">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_picsa_fsm_intervention_method_form" model="ir.ui.view">
        <field name="name">picsa.fsm.intervention.method.form</field>
        <field name="model">picsa.fsm.intervention.method</field>
        <field name="arch" type="xml">
            <form string="Método de Intervención">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_picsa_fsm_service_form" model="ir.ui.view">
        <field name="name">picsa.fsm.service.form</field>
        <field name="model">picsa.fsm.service</field>
        <field name="arch" type="xml">
            <form string="Servicio Realizado">
                <header>
                    <button name="action_open_signature_wizard" string="Firmar y Enviar"
                            type="object" class="btn-primary"/>
                    <button name="action_reopen" string="Reabrir" type="object"
                            class="btn-primary" invisible="state_code != 'done'"/>
                </header>
                <sheet>
                    <field name="state_code" invisible="1"/>
                    <group>
                        <field name="fsm_order_id" readonly="state_code == 'done'"/>
                        <field name="technician_id" readonly="state_code == 'done'"/>
                        <field name="state_id" readonly="state_code == 'done'"/>
                    </group>
                    <group>
                        <field name="date_start" readonly="state_code == 'done'"/>
                        <field name="date_end" readonly="state_code == 'done'"/>
                        <field name="intervention_method_id" readonly="state_code == 'done'"/>
                        <field name="km" readonly="state_code == 'done'"/>
                        <field name="notes" readonly="state_code == 'done'"/>
                    </group>
                    <group string="Firma">
                        <field name="signature" widget="image" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_picsa_fsm_service_signature_wizard_form" model="ir.ui.view">
        <field name="name">picsa.fsm.service.signature.wizard.form</field>
        <field name="model">picsa.fsm.service.signature.wizard</field>
        <field name="arch" type="xml">
            <form string="Firmar Servicio">
                <field name="service_id" invisible="1"/>
                <group>
                    <field name="signature" widget="signature"/>
                </group>
                <footer>
                    <button name="action_sign" string="Firmar"
                            type="object" class="btn-secondary"/>
                    <button name="action_sign_and_send" string="Firmar y Enviar"
                            type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_picsa_fsm_material_tree" model="ir.ui.view">
        <field name="name">picsa.fsm.material.tree</field>
        <field name="model">picsa.fsm.material</field>
        <field name="arch" type="xml">
            <tree string="Materiales">
                <field name="fsm_order_id"/>
                <field name="material_type"/>
                <field name="sequence"/>
                <field name="brand"/>
                <field name="model_id"/>
                <field name="serial_number"/>
                <field name="quantity"/>
            </tree>
        </field>
    </record>

    <record id="view_picsa_fsm_material_form" model="ir.ui.view">
        <field name="name">picsa.fsm.material.form</field>
        <field name="model">picsa.fsm.material</field>
        <field name="arch" type="xml">
            <form string="Material">
                <sheet>
                    <group>
                        <field name="fsm_order_id"/>
                        <field name="material_type"/>
                        <field name="sequence"/>
                        <field name="brand"/>
                        <field name="model_id"/>
                        <field name="serial_number"/>
                        <field name="quantity"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
